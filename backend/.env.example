# ─── 培训学校收费系统 · 后端环境变量示例 ───
# 复制为 .env 后按需修改；.env 不得提交到版本库

# 服务
NODE_ENV=development
PORT=3000

# 数据库（docker-compose 默认值见 docker-compose.yml）
DATABASE_URL="mysql://tfs:tfs_password_change_me@mysql:3306/training_fee?charset=utf8mb4"

# Redis
REDIS_URL="redis://redis:6379"

# 管理员 JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# 数据加密主密钥（64 位 hex；生产环境必填，用于手机号/支付密钥加密）
MASTER_KEY=

# 登录码 pepper（HMAC 密钥；生产环境必填，换 pepper 会导致旧码失效）
LOGIN_CODE_PEPPER=dev-only-pepper-change-me

# 学生会话 Cookie
SESSION_COOKIE_NAME=tfs_session
SESSION_TTL_HOURS=72

# 微信支付：mock（联调用）/ real（真实商户号）
WECHAT_PAY_MODE=mock

# 真实模式备用（也可全部走支付账户表配置，此处仅作覆盖/默认值）
# WECHAT_APP_ID=
# WECHAT_MCH_ID=

# 导出文件目录
EXPORT_DIR=/tmp/tfs-exports

# 种子数据超管密码（仅 seed 时使用）
SEED_ADMIN_PASSWORD=Admin@123456
